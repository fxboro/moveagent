  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "approved_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 10,
            "title": "Approved Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approved_ids"
        ],
        "title": "Approval"
      },
      "CandidateCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "raw_cv_text": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 30,
            "title": "Raw Cv Text"
          },
          "language_level": {
            "type": "string",
            "enum": [
              "None",
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ],
            "title": "Language Level",
            "default": "None"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "raw_cv_text"
        ],
        "title": "CandidateCreate"
      },
      "CheckRequest": {
        "properties": {
          "institution_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Institution Name",
            "default": "Not specified"
          },
          "source": {
            "type": "string",
            "enum": [
              "anabin",
              "migration",
              "zab"
            ],
            "title": "Source",
            "default": "anabin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CheckRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}